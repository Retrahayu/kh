# /etc/khanza/webswing.env — optional overrides read by webswing.service
# (EnvironmentFile=-/etc/khanza/webswing.env). Keep values out of the unit file.

# Bind address for the app port. 0.0.0.0 = direct browser access (Webswing's demo login
# is exposed). 127.0.0.1 = only reachable through the httpd edge proxy (recommended).
WEBSWING_BIND=0.0.0.0

# Uncomment to debug JavaFX/Prism problems (logs to the journal):
#JAVA_OPTS=-Xmx2g -Dprism.verbose=true

# Uncomment for a different heap if the host has more RAM (default in the unit is -Xmx2g):
#WEBSWING_HEAP=-Xmx4g
