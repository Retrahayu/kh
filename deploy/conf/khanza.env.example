# /etc/khanza/khanza.env — ONE source of truth for every Khanza connection setting.
# Install as:  install -m 600 khanza.env.example /etc/khanza/khanza.env
# Never commit the filled-in file. Values are placeholders.

# ── Database used by the PHP web modules (conf/conf.php) ────────────────────
KHANZA_DB_HOST=127.0.0.1
KHANZA_DB_PORT=3306
KHANZA_DB_NAME=sik
KHANZA_DB_USER=khanza
KHANZA_DB_PASS=change-me-strong-random-32-plus-chars

# ── Database used by the Java client (AES-encrypted database.xml) ───────────
# Usually the same account; separated so JDBC can be pointed at the private IP.
KHANZA_JDBC_HOST=10.0.0.10
KHANZA_JDBC_PORT=3306
KHANZA_JDBC_NAME=sik
KHANZA_JDBC_USER=khanza
KHANZA_JDBC_PASS=change-me-strong-random-32-plus-chars

# ── Hybrid-web defines inside webapps/conf/conf.php ─────────────────────────
KHANZA_HYBRID_HOST=10.0.0.10
KHANZA_HYBRID_USER=root
KHANZA_HYBRID_PASS=change-me

# ── AES material for the client database.xml ────────────────────────────────
# 16 bytes each. The upstream Khanza defaults are public knowledge; keep your own
# and mirror them wherever the client is decrypted.
KHANZA_AES_KEY=Bar12345Bar12345
KHANZA_AES_IV=sayangsamakhanza

# ── Administrative DB credentials (used ONLY by harden-khanza.sh / backup-khanza.sh) ──
# Never used by the running apps. Rotate it once the app uses KHANZA_DB_USER.
KHANZA_ADMIN_USER=root
KHANZA_ADMIN_PASS=change-me-admin-password

# ── Paths (override only if your layout differs) ────────────────────────────
KHANZA_WEBROOT=/var/www/html
KHANZA_CLIENT=/opt/simrs-khanza/client
KHANZA_WS=/opt/webswing/webswing-eval-26.2
